OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1800

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://simplificandocifras.netlify.app

RESUMO_RATE_LIMIT=10 per minute
# Use redis://... no Railway quando houver mais de uma instância ou worker.
RATELIMIT_STORAGE_URI=memory://
MAX_CONTENT_LENGTH=65536
MAX_TEXT_LENGTH=50000
