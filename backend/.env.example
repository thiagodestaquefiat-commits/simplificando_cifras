OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=12000

CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5500,http://localhost:5500,https://simplificandocifras.netlify.app

RESUMO_RATE_LIMIT=10 per minute
# Use redis://... no Railway quando houver mais de uma instância ou worker.
RATELIMIT_STORAGE_URI=memory://
MAX_CONTENT_LENGTH=65536
MAX_TEXT_LENGTH=50000
PORT=5000

# Railway PostgreSQL: use a variável DATABASE_URL fornecida pelo serviço.
# Sem ela, o desenvolvimento local usa SQLite em instance/simplificando_cifras.db.
DATABASE_URL=
COLLABORATION_TOKEN_BYTES=32

# Endereços e mapa dos eventos. Esta primeira chave fica somente no backend Railway.
# Crie uma chave gratuita em https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
# Chave pública separada, restrita no Geoapify aos domínios do Netlify e localhost.
# É usada somente nos tiles do mapa interativo e pode ser vista pelo navegador.
GEOAPIFY_BROWSER_KEY=
LOCATION_PROVIDER=geoapify
LOCATION_TIMEOUT_SECONDS=6
LOCATION_CACHE_TTL_SECONDS=600
LOCATION_SEARCH_RATE_LIMIT=30 per minute
LOCATION_MAP_RATE_LIMIT=60 per minute
LOCATION_CONFIG_RATE_LIMIT=60 per minute

# Login do aplicativo (Supabase Auth). As duas variáveis são configuradas no Railway.
# A anon key é pública por definição; nunca use a service_role no frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=6
AUTH_CONFIG_RATE_LIMIT=60 per minute

# YouTube Data API v3. A chave fica somente no Railway e nunca vai ao navegador.
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=8
# Evita consumir uma nova busca para título/artista já consultado no mesmo processo.
YOUTUBE_CACHE_TTL_SECONDS=86400
YOUTUBE_SEARCH_RATE_LIMIT=20 per minute
YOUTUBE_CONFIG_RATE_LIMIT=60 per minute
